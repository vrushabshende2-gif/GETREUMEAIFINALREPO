# Server Environment Variables
# In production (e.g. Render/Heroku), add these to your environment variables settings.

PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=GETRESUMEAIFINAL

# JWT Secrets for Authentication (Generate strong random strings)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Email SMTP Config for OTPs
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# GROQ API Key for AI Features
GROQ_API_KEY=your_groq_api_key

# Admin User Credentials (Created automatically if not exists)
ADMIN_EMAIL=admin@getresume.ai
ADMIN_PASSWORD=AdminSecurePass123!

# CORS - Set to your production frontend URL (e.g. https://your-frontend.vercel.app)
ALLOWED_ORIGINS=https://your-frontend.vercel.app
